          { en: "faster than the bus", pt: "mais rápido que o ônibus" },
          { en: "slower than the car", pt: "mais lento que o carro" },
          { en: "colder than today", pt: "mais frio que hoje" },
          { en: "warmer than yesterday", pt: "mais quente que ontem" },
          { en: "longer than the pencil", pt: "mais comprido que o lápis" },
          { en: "stronger than before", pt: "mais forte que antes" },
          { en: "lighter than mine", pt: "mais leve que o meu" }
        ]
      },
      {
        name: "Comparatives - Spelling Changes",
        short: "regras de escrita",
        tip: "Observe como algumas palavras mudam na escrita ao formar o comparativo.",
        pairs: [
          { en: "bigger than the bag", pt: "maior que a bolsa" },
          { en: "hotter than yesterday", pt: "mais quente que ontem" },
          { en: "happier than before", pt: "mais feliz que antes" },
          { en: "easier than Math", pt: "mais fácil que Matemática" },
          { en: "busier than my mom", pt: "mais ocupado que minha mãe" },
          { en: "nicer than this book", pt: "mais legal que este livro" },
          { en: "larger than my room", pt: "maior que meu quarto" },
          { en: "safer than the street", pt: "mais seguro que a rua" },
          { en: "fatter than the cat", pt: "mais gordo que o gato" },
          { en: "thinner than my notebook", pt: "mais fino que meu caderno" },
          { en: "prettier than the doll", pt: "mais bonita que a boneca" },
          { en: "crazier than before", pt: "mais maluco que antes" }
        ]
      },
      {
        name: "Comparatives - Long and Irregular",
        short: "longos e irregulares",
        tip: "Nesta fase aparecem adjetivos longos e também comparativos irregulares.",
        pairs: [
          { en: "more interesting than Science", pt: "mais interessante que Ciências" },
          { en: "more expensive than this phone", pt: "mais caro que este celular" },
          { en: "more beautiful than the garden", pt: "mais bonito que o jardim" },
