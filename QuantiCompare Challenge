<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>7º Ano - QuantiCompare Challenge</title>
  <style>
    :root{
      --bg1:#070718;
      --bg2:#12002b;
      --cyan:#00eaff;
      --purple:#a855f7;
      --green:#30ff9a;
      --pink:#ff3df2;
      --gold:#ffd166;
      --red:#ff466d;
      --text:#f5f7ff;
      --muted:#a7b0d8;
    }

    *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}

    html, body{
      margin:0;
      width:100%;
      min-height:100%;
      font-family:Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color:var(--text);
      background:
        radial-gradient(circle at 15% 8%, rgba(0,234,255,.22), transparent 32%),
        radial-gradient(circle at 85% 18%, rgba(168,85,247,.26), transparent 34%),
        radial-gradient(circle at 50% 90%, rgba(255,61,242,.15), transparent 30%),
        linear-gradient(160deg, var(--bg1), var(--bg2));
      overflow-x:hidden;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      background-image:
        linear-gradient(rgba(0,234,255,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,234,255,.035) 1px, transparent 1px);
      background-size:28px 28px;
      mask-image:linear-gradient(to bottom, rgba(0,0,0,.85), rgba(0,0,0,.22));
      pointer-events:none;
    }

    .app{
      position:relative;
      width:min(100%, 480px);
      min-height:100dvh;
      margin:0 auto;
      padding:12px 12px 18px;
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .screen{
      display:none;
      min-height:calc(100dvh - 30px);
      animation:fadeIn .35s ease both;
    }

    .screen.active{display:flex; flex-direction:column;}

    #gameScreen.active{
      height:calc(100dvh - 30px);
      min-height:0;
      overflow:hidden;
    }

    @keyframes fadeIn{
      from{opacity:0; transform:translateY(8px)}
      to{opacity:1; transform:translateY(0)}
    }

    .title-card{
      flex:1;
      display:flex;
      flex-direction:column;
      justify-content:center;
      align-items:center;
      text-align:center;
      padding:24px 16px;
    }

    .logo{
      width:120px;
      height:120px;
      display:grid;
      place-items:center;
      border-radius:34px;
      background:linear-gradient(145deg, rgba(0,234,255,.22), rgba(168,85,247,.22));
      border:1px solid rgba(255,255,255,.20);
      box-shadow:0 0 35px rgba(0,234,255,.25), inset 0 0 22px rgba(255,255,255,.08);
      font-size:56px;
      margin-bottom:18px;
      animation:float 2.8s ease-in-out infinite;
    }

    @keyframes float{
      0%,100%{transform:translateY(0)}
      50%{transform:translateY(-8px)}
    }

    h1{
      margin:0;
      font-size:clamp(2rem, 9vw, 3.1rem);
      line-height:.95;
      letter-spacing:-1px;
      text-shadow:0 0 18px rgba(0,234,255,.45);
    }

    .subtitle{
      margin:14px 0 0;
      color:var(--muted);
      font-size:1rem;
      line-height:1.45;
      max-width:360px;
    }

    .teacher{
      color:var(--gold);
      font-weight:800;
      margin-top:8px;
      text-shadow:0 0 10px rgba(255,209,102,.25);
    }

    .primary-btn, .secondary-btn{
      width:100%;
      border:0;
      border-radius:20px;
      padding:16px 18px;
      color:#07111f;
      font-weight:950;
      font-size:1rem;
      letter-spacing:.3px;
      cursor:pointer;
      background:linear-gradient(135deg, var(--cyan), var(--green));
      box-shadow:0 0 24px rgba(0,234,255,.34), 0 8px 18px rgba(0,0,0,.25);
      transition:.18s ease;
    }

    .primary-btn:active, .secondary-btn:active, .word-btn:active{transform:scale(.97)}

    .secondary-btn{
      background:rgba(255,255,255,.08);
      color:var(--text);
      border:1px solid rgba(255,255,255,.18);
      box-shadow:none;
    }

    .phase-grid{
      display:grid;
      grid-template-columns:repeat(2, 1fr);
      gap:12px;
      width:100%;
      margin-top:22px;
    }

    .phase-btn{
      min-height:76px;
      border-radius:18px;
      border:1px solid rgba(255,255,255,.16);
      background:linear-gradient(145deg, rgba(0,234,255,.13), rgba(168,85,247,.14));
      color:var(--text);
      font-weight:900;
      box-shadow:inset 0 0 18px rgba(255,255,255,.05), 0 0 18px rgba(168,85,247,.14);
      cursor:pointer;
      font-size:.92rem;
      padding:8px;
    }

    .phase-btn.locked{
      opacity:.48;
      filter:grayscale(.4);
      cursor:not-allowed;
    }

    .phase-small{
      display:block;
      margin-top:4px;
      color:var(--muted);
      font-size:.76rem;
      font-weight:700;
    }

    .hud{
      display:grid;
      grid-template-columns:1fr auto 1fr;
      align-items:center;
      gap:8px;
      padding:10px;
      border-radius:22px;
      background:rgba(3, 8, 28, .72);
      border:1px solid rgba(255,255,255,.13);
      box-shadow:0 0 24px rgba(0,234,255,.14), inset 0 0 16px rgba(255,255,255,.04);
      backdrop-filter:blur(10px);
      flex:0 0 auto;
    }

    .pill{
      border-radius:999px;
      padding:9px 10px;
      background:rgba(255,255,255,.07);
      border:1px solid rgba(255,255,255,.10);
      font-size:.82rem;
      font-weight:850;
      text-align:center;
      white-space:nowrap;
    }

    .hearts{
      letter-spacing:1px;
      font-size:1.05rem;
      text-shadow:0 0 10px rgba(255,70,109,.4);
    }

    .game-title{
      text-align:center;
      padding:4px 4px 0;
      flex:0 0 auto;
    }

    .game-title h2{
      margin:0;
      font-size:1.14rem;
      text-shadow:0 0 14px rgba(0,234,255,.36);
    }

    .game-title p{
      margin:5px auto 0;
      max-width:390px;
      font-size:.82rem;
      line-height:1.35;
      color:var(--muted);
    }

    .board-wrap{
      flex:1 1 auto;
      min-height:0;
      display:flex;
      align-items:center;
    }

    .board{
      width:100%;
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
      position:relative;
    }

    .col-label{
      text-align:center;
      font-size:.72rem;
      color:var(--gold);
      font-weight:950;
      letter-spacing:.8px;
      text-transform:uppercase;
      margin-bottom:-4px;
      text-shadow:0 0 10px rgba(255,209,102,.22);
    }

    .column{
      display:grid;
      gap:9px;
    }

    .word-btn{
      min-height:62px;
      border:1px solid rgba(255,255,255,.14);
      border-radius:18px;
      padding:10px 8px;
      color:var(--text);
      background:linear-gradient(145deg, rgba(255,255,255,.08), rgba(0,234,255,.06));
      box-shadow:0 0 18px rgba(0,234,255,.10), inset 0 0 18px rgba(255,255,255,.04);
      font-size:clamp(.88rem, 3.7vw, 1.03rem);
      font-weight:950;
      cursor:pointer;
      position:relative;
      overflow:hidden;
      transition:transform .18s ease, border-color .18s ease, box-shadow .18s ease, opacity .24s ease;
    }

    .word-btn.pt{
      background:linear-gradient(145deg, rgba(168,85,247,.16), rgba(255,61,242,.07));
    }

    .word-btn::after{
      content:"";
      position:absolute;
      inset:-70% auto auto -30%;
      width:40%;
      height:220%;
      background:linear-gradient(90deg, transparent, rgba(255,255,255,.18), transparent);
      transform:rotate(25deg);
      transition:.35s ease;
    }

    .word-btn:hover::after, .word-btn.selected::after{left:115%;}

    .word-btn.selected{
      border-color:var(--gold);
      box-shadow:0 0 22px rgba(255,209,102,.42), inset 0 0 20px rgba(255,209,102,.08);
      transform:translateY(-2px);
    }

    .word-btn.correct{
      border-color:var(--green);
      background:linear-gradient(145deg, rgba(48,255,154,.32), rgba(0,234,255,.14));
      box-shadow:0 0 26px rgba(48,255,154,.55);
      animation:popCorrect .62s ease both;
    }

    @keyframes popCorrect{
      0%{transform:scale(1)}
      42%{transform:scale(1.06)}
      100%{transform:scale(.88); opacity:0}
    }

    .word-btn.wrong{
      border-color:var(--red);
      background:linear-gradient(145deg, rgba(255,70,109,.32), rgba(255,61,242,.10));
      box-shadow:0 0 22px rgba(255,70,109,.45);
      animation:shake .42s ease;
    }

    @keyframes shake{
      0%,100%{transform:translateX(0)}
      20%{transform:translateX(-5px)}
      40%{transform:translateX(5px)}
      60%{transform:translateX(-4px)}
      80%{transform:translateX(4px)}
    }

    .empty-slot{
      min-height:62px;
      border:1px dashed rgba(255,255,255,.12);
      border-radius:18px;
      background:rgba(255,255,255,.025);
      opacity:.65;
    }

    .footer-actions{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
      margin-top:2px;
      flex:0 0 auto;
    }

    .status-line{
      min-height:28px;
      text-align:center;
      color:var(--gold);
      font-size:.82rem;
      font-weight:850;
      padding:3px 8px;
      flex:0 0 auto;
    }

    .overlay{
      position:fixed;
      inset:0;
      z-index:20;
      display:none;
      align-items:center;
      justify-content:center;
      padding:18px;
      background:rgba(0,0,0,.72);
      backdrop-filter:blur(8px);
    }

    .overlay.show{display:flex; animation:fadeIn .25s ease both;}

    .modal{
      width:min(100%, 420px);
      border-radius:28px;
      padding:24px 18px;
      text-align:center;
      background:linear-gradient(160deg, rgba(8,13,42,.98), rgba(30,8,72,.98));
      border:1px solid rgba(255,255,255,.18);
      box-shadow:0 0 38px rgba(0,234,255,.25), inset 0 0 26px rgba(255,255,255,.05);
    }

    .modal .big{
      font-size:4rem;
      margin:0 0 8px;
      filter:drop-shadow(0 0 14px rgba(0,234,255,.45));
    }

    .modal h2{
      margin:0;
      font-size:1.75rem;
    }

    .modal p{
      color:var(--muted);
      line-height:1.45;
      margin:10px 0 18px;
    }

    .confetti{
      position:fixed;
      inset:0;
      pointer-events:none;
      overflow:hidden;
      z-index:30;
    }

    .piece{
      position:absolute;
      top:-12px;
      width:9px;
      height:16px;
      border-radius:3px;
      animation:fall linear forwards;
    }

    @keyframes fall{
      to{transform:translateY(110vh) rotate(720deg); opacity:.1}
    }

    @media (max-height:720px){
      .word-btn,.empty-slot{min-height:56px;}
    }

    @media (max-height:660px){
      .word-btn,.empty-slot{min-height:48px; font-size:.78rem;}
      .column{gap:6px;}
      .game-title p{display:none;}
      .status-line{font-size:.72rem; min-height:22px;}
      .footer-actions .secondary-btn{padding:12px 14px;}
    }
  </style>
</head>
<body>
  <main class="app">
    <section id="homeScreen" class="screen active">
      <div class="title-card">
        <div class="logo">🎯</div>
        <h1>QuantiCompare<br>Challenge</h1>
        <p class="subtitle">
          Um jogo para praticar <strong>Quantifiers</strong> e <strong>Comparatives</strong>.
          Clique na palavra em inglês para ouvir e depois encontre a tradução correta.
        </p>
        <div class="teacher">Turma 703 • Professor Jasson Bruno</div>

        <div style="width:100%; max-width:380px; margin-top:18px; display:grid; gap:10px;">
          <button class="primary-btn" onclick="showPhases()">COMEÇAR</button>
          <button class="secondary-btn" onclick="showHomeInfo()">COMO JOGAR</button>
        </div>
      </div>
    </section>

    <section id="phaseScreen" class="screen">
      <div class="title-card" style="justify-content:flex-start; padding-top:18px;">
        <div class="logo" style="width:82px;height:82px;font-size:38px;border-radius:26px;margin-bottom:12px;">🔓</div>
        <h1 style="font-size:2.1rem;">Escolha a fase</h1>
        <p class="subtitle">Complete 10 pares para vencer. Ao concluir uma fase, a próxima será liberada.</p>
        <div id="phaseGrid" class="phase-grid"></div>
        <div style="width:100%; max-width:380px; margin-top:18px;">
          <button class="secondary-btn" onclick="showHome()">VOLTAR</button>
        </div>
      </div>
    </section>

    <section id="gameScreen" class="screen">
      <div class="hud">
        <div class="pill" id="phaseHud">Fase 1</div>
        <div class="pill hearts" id="heartsHud">❤️❤️❤️❤️❤️</div>
        <div class="pill" id="progressHud">Pares: 0/10</div>
      </div>

      <div class="game-title">
        <h2 id="phaseTitle">Quantifiers Basics</h2>
        <p id="phaseTip">Clique em uma palavra em inglês para ouvir. Depois clique na tradução correta em português.</p>
      </div>

      <div class="status-line" id="statusLine">Leia com calma. Os pares não aparecem alinhados.</div>

      <div class="board-wrap">
        <div style="width:100%;">
          <div class="board">
            <div class="col-label">English</div>
            <div class="col-label">Português</div>
            <div class="column" id="englishColumn"></div>
            <div class="column" id="portugueseColumn"></div>
          </div>
        </div>
      </div>

      <div class="footer-actions">
        <button class="secondary-btn" onclick="backToPhases()">FASES</button>
        <button class="secondary-btn" onclick="restartCurrentPhase()">REINICIAR</button>
      </div>
    </section>
  </main>

  <div class="overlay" id="resultOverlay">
    <div class="modal">
      <div class="big" id="resultIcon">🏆</div>
      <h2 id="resultTitle">Parabéns!</h2>
      <p id="resultText">Você completou a fase.</p>
      <div style="display:grid; gap:10px;">
        <button class="primary-btn" id="mainResultBtn">PRÓXIMA FASE</button>
        <button class="secondary-btn" onclick="closeOverlay(); showPhases();">VER FASES</button>
      </div>
    </div>
  </div>

  <div class="confetti" id="confetti"></div>

  <script>
    const PHASES = [
      {
        name: "Quantifiers - Basic Meanings",
        short: "quantifiers 1",
        tip: "Ouça a expressão em inglês e associe com o significado em português.",
        pairs: [
          { en: "all students", pt: "todos os alunos" },
          { en: "most students", pt: "a maioria dos alunos" },
          { en: "many books", pt: "muitos livros" },
          { en: "much water", pt: "muita água" },
          { en: "some apples", pt: "algumas maçãs" },
          { en: "a few friends", pt: "alguns poucos amigos" },
          { en: "a lot of homework", pt: "muita tarefa de casa" },
          { en: "not many cars", pt: "não muitos carros" },
          { en: "some pencils", pt: "alguns lápis" },
          { en: "a few cookies", pt: "alguns poucos biscoitos" },
          { en: "most teachers", pt: "a maioria dos professores" },
          { en: "all notebooks", pt: "todos os cadernos" }
        ]
      },
      {
        name: "Quantifiers - Sentences",
        short: "quantifiers 2",
        tip: "Agora observe os quantifiers dentro de frases simples.",
        pairs: [
          { en: "There are many books.", pt: "Há muitos livros." },
          { en: "There is much milk.", pt: "Há muito leite." },
          { en: "I have some games.", pt: "Eu tenho alguns jogos." },
          { en: "We have a few classes.", pt: "Nós temos algumas poucas aulas." },
          { en: "All students are here.", pt: "Todos os alunos estão aqui." },
          { en: "Most people like music.", pt: "A maioria das pessoas gosta de música." },
          { en: "There is a lot of food.", pt: "Há muita comida." },
          { en: "There are not many chairs.", pt: "Não há muitas cadeiras." },
          { en: "She has some friends.", pt: "Ela tem alguns amigos." },
          { en: "He has a few pencils.", pt: "Ele tem alguns poucos lápis." },
          { en: "There is much juice.", pt: "Há muito suco." },
          { en: "We have a lot of time.", pt: "Nós temos muito tempo." }
        ]
      },
      {
        name: "Quantifiers - Countable and Uncountable",
        short: "contável x incontável",
        tip: "Nesta fase, você vai relacionar expressões com substantivos contáveis e incontáveis.",
        pairs: [
          { en: "many students", pt: "muitos alunos" },
          { en: "many pencils", pt: "muitos lápis" },
          { en: "much money", pt: "muito dinheiro" },
          { en: "much juice", pt: "muito suco" },
          { en: "a lot of rice", pt: "muito arroz" },
          { en: "some bananas", pt: "algumas bananas" },
          { en: "a few books", pt: "alguns poucos livros" },
          { en: "not many teachers", pt: "não muitos professores" },
          { en: "all the chairs", pt: "todas as cadeiras" },
          { en: "most of the class", pt: "a maior parte da turma" },
          { en: "a lot of time", pt: "muito tempo" },
          { en: "some cookies", pt: "alguns biscoitos" }
        ]
      },
      {
        name: "Comparatives - Short Adjectives",
        short: "comparatives 1",
        tip: "Agora começamos as comparações. Ouça e relacione a expressão ao significado.",
        pairs: [
          { en: "taller than me", pt: "mais alto que eu" },
          { en: "shorter than João", pt: "mais baixo que João" },
          { en: "smaller than the box", pt: "menor que a caixa" },
          { en: "older than my brother", pt: "mais velho que meu irmão" },
