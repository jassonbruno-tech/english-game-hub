        tip: "Desafio final com quantifiers e comparatives misturados. Mostre o que você aprendeu.",
        pairs: [
          { en: "all students are here", pt: "todos os alunos estão aqui" },
          { en: "most books are more interesting than the movie", pt: "a maioria dos livros é mais interessante que o filme" },
          { en: "many pencils are on the desk", pt: "muitos lápis estão na carteira" },
          { en: "a few teachers are happier today", pt: "alguns poucos professores estão mais felizes hoje" },
          { en: "some cars are smaller than the bus", pt: "alguns carros são menores que o ônibus" },
          { en: "there is much juice in the cup", pt: "há muito suco no copo" },
          { en: "this test is easier than the last one", pt: "este teste é mais fácil que o último" },
          { en: "this phone is more expensive than mine", pt: "este celular é mais caro que o meu" },
          { en: "my house is bigger than yours", pt: "minha casa é maior que a sua" },
          { en: "English is more interesting than Math", pt: "Inglês é mais interessante que Matemática" },
          { en: "there are not many chairs here", pt: "não há muitas cadeiras aqui" },
          { en: "most students are younger than the teacher", pt: "a maioria dos alunos é mais jovem que o professor" }
        ]
      }
    ];

    const TOTAL_PHASES = PHASES.length;
    const PAIRS_TO_WIN = 10;
    const INITIAL_LIVES = 5;

    let currentPhase = 0;
    let unlockedPhase = 1;
    let lives = INITIAL_LIVES;
    let correctPairs = 0;
    let selected = null;
    let englishItems = [];
    let portugueseItems = [];
    let phaseQueue = [];
    let nextPairPointer = 0;
    let locked = false;
    let sharedAudioCtx = null;

    const homeScreen = document.getElementById("homeScreen");
    const phaseScreen = document.getElementById("phaseScreen");
    const gameScreen = document.getElementById("gameScreen");
    const phaseGrid = document.getElementById("phaseGrid");
    const englishColumn = document.getElementById("englishColumn");
    const portugueseColumn = document.getElementById("portugueseColumn");
    const phaseHud = document.getElementById("phaseHud");
    const heartsHud = document.getElementById("heartsHud");
    const progressHud = document.getElementById("progressHud");
    const phaseTitle = document.getElementById("phaseTitle");
    const phaseTip = document.getElementById("phaseTip");
    const statusLine = document.getElementById("statusLine");
    const overlay = document.getElementById("resultOverlay");
    const resultIcon = document.getElementById("resultIcon");
    const resultTitle = document.getElementById("resultTitle");
    const resultText = document.getElementById("resultText");
    const mainResultBtn = document.getElementById("mainResultBtn");
    const confettiBox = document.getElementById("confetti");

    function showOnly(screen){
      [homeScreen, phaseScreen, gameScreen].forEach(s => s.classList.remove("active"));
      screen.classList.add("active");
    }

    function showHome(){ showOnly(homeScreen); }

    function showHomeInfo(){
      resultIcon.textContent = "🎮";
      resultTitle.textContent = "Como jogar";
      resultText.textContent = "Clique em uma palavra ou frase em inglês para ouvir a pronúncia. Depois clique na tradução correta em português. Complete 10 pares para vencer a fase.";
      mainResultBtn.textContent = "ENTENDI";
      mainResultBtn.onclick = closeOverlay;
      overlay.classList.add("show");
    }

    function showPhases(){
      renderPhaseGrid();
      showOnly(phaseScreen);
    }

    function backToPhases(){
      renderPhaseGrid();
      showOnly(phaseScreen);
    }

    function renderPhaseGrid(){
      phaseGrid.innerHTML = "";
      PHASES.forEach((phase, index) => {
        const btn = document.createElement("button");
        btn.className = "phase-btn" + (index + 1 > unlockedPhase ? " locked" : "");
        btn.innerHTML = `${index + 1 > unlockedPhase ? "🔒" : "⚡"} Fase ${index + 1}<span class="phase-small">${phase.short}</span>`;
        btn.onclick = () => {
          if(index + 1 <= unlockedPhase){ startPhase(index); }
        };
        phaseGrid.appendChild(btn);
      });
    }

    function startPhase(index){
      currentPhase = index;
      lives = INITIAL_LIVES;
      correctPairs = 0;
      selected = null;
      locked = false;

      buildPhaseQueue();
      buildInitialBoard();

      phaseTitle.textContent = PHASES[currentPhase].name;
      phaseTip.textContent = PHASES[currentPhase].tip;
      statusLine.textContent = "Leia com calma. Os pares não aparecem alinhados.";

      updateHud();
      showOnly(gameScreen);
      renderBoard();
    }

    function restartCurrentPhase(){
      startPhase(currentPhase);
    }

    function buildPhaseQueue(){
      const shuffled = shuffle([...PHASES[currentPhase].pairs]).slice(0, PAIRS_TO_WIN);
      phaseQueue = shuffled.map((pair, i) => ({
        pairId: i,
        en: pair.en,
        pt: pair.pt
      }));
      nextPairPointer = 0;
    }

    function buildInitialBoard(){
      const initialPairs = phaseQueue.slice(0, 5);
      nextPairPointer = initialPairs.length;

      englishItems = initialPairs.map(pair => makeItem(pair, "en"));
      portugueseItems = initialPairs.map(pair => makeItem(pair, "pt"));

      shuffle(englishItems);
      shufflePortugueseAvoidRows();
    }

    function makeItem(pair, lang){
      return {
        pairId: pair.pairId,
        lang,
        text: lang === "en" ? pair.en : pair.pt,
        uid: `${lang}-${pair.pairId}-${Math.random().toString(36).slice(2)}`
      };
    }

    function shuffle(arr){
      for(let i = arr.length - 1; i > 0; i--){
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    function shufflePortugueseAvoidRows(){
      let attempts = 0;
      do{
        shuffle(portugueseItems);
        attempts++;
      } while(hasRowPair() && attempts < 120);
    }

    function hasRowPair(){
      const max = Math.min(englishItems.length, portugueseItems.length);
      for(let i = 0; i < max; i++){
        if(englishItems[i] && portugueseItems[i] && englishItems[i].pairId === portugueseItems[i].pairId){
          return true;
        }
      }
      return false;
    }

    function updateHud(){
      phaseHud.textContent = `Fase ${currentPhase + 1}`;
      heartsHud.textContent = "❤️".repeat(lives) + "🖤".repeat(INITIAL_LIVES - lives);
      progressHud.textContent = `Pares: ${correctPairs}/${PAIRS_TO_WIN}`;
    }

    function renderBoard(){
      englishColumn.innerHTML = "";
      portugueseColumn.innerHTML = "";

      renderColumn(englishColumn, englishItems, "en");
      renderColumn(portugueseColumn, portugueseItems, "pt");
    }

    function renderColumn(column, items, lang){
      for(let i = 0; i < 5; i++){
        const item = items[i];
        if(!item){
          const empty = document.createElement("div");
          empty.className = "empty-slot";
          column.appendChild(empty);
          continue;
        }
        const btn = document.createElement("button");
        btn.className = `word-btn ${lang === "pt" ? "pt" : ""}`;
        btn.textContent = item.text;
        btn.dataset.uid = item.uid;
        btn.onclick = () => selectItem(item, btn);
        column.appendChild(btn);
      }
    }

    function selectItem(item, btn){
      if(locked) return;

      if(item.lang === "en"){
        speakEnglish(item.text);
      }

      if(selected && selected.item.uid === item.uid){
        clearSelection();
        return;
      }

      if(!selected){
        selected = { item, btn };
        btn.classList.add("selected");
        return;
      }

      if(selected.item.lang === item.lang){
        selected.btn.classList.remove("selected");
        selected = { item, btn };
        btn.classList.add("selected");
        return;
      }

      const first = selected;
      const second = { item, btn };
      checkPair(first, second);
    }

    function checkPair(a, b){
      locked = true;
      const isCorrect = a.item.pairId === b.item.pairId;
      if(isCorrect){
        handleCorrect(a, b);
      } else {
        handleWrong(a, b);
      }
    }

    function handleCorrect(a, b){
      a.btn.classList.remove("selected");
      b.btn.classList.remove("selected");
      a.btn.classList.add("correct");
      b.btn.classList.add("correct");

      playSuccessChime();
      correctPairs++;
      updateHud();
      statusLine.textContent = getMotivation();

      setTimeout(() => {
        removeItem(a.item);
        removeItem(b.item);

        if(correctPairs >= PAIRS_TO_WIN){
          renderBoard();
          winPhase();
          return;
        }

        if(correctPairs >= 3){
          refillBoardToFivePairs();
          randomizeBoardPositions();
          statusLine.textContent = "Novas palavras entraram no desafio. Continue com atenção.";
        } else {
          randomizeBoardPositions();
          statusLine.textContent = `Muito bem! A reposição começa depois do 3º par. Faltam ${3 - correctPairs}.`;
        }

        selected = null;
        locked = false;
        renderBoard();
      }, 650);
    }

    function handleWrong(a, b){
      a.btn.classList.add("wrong");
      b.btn.classList.add("wrong");
      lives--;
      updateHud();
      statusLine.textContent = "Quase! Observe melhor as palavras e tente de novo.";

      setTimeout(() => {
        a.btn.classList.remove("selected", "wrong");
        b.btn.classList.remove("wrong");
        selected = null;
        locked = false;
        if(lives <= 0){
          gameOver();
        }
      }, 900);
    }

    function clearSelection(){
      if(selected){
        selected.btn.classList.remove("selected");
      }
      selected = null;
    }

    function removeItem(item){
      if(item.lang === "en"){
        englishItems = englishItems.filter(x => x.uid !== item.uid);
      } else {
        portugueseItems = portugueseItems.filter(x => x.uid !== item.uid);
      }
    }

    function refillBoardToFivePairs(){
      while(englishItems.length < 5 && portugueseItems.length < 5 && nextPairPointer < phaseQueue.length){
        const pair = phaseQueue[nextPairPointer];
        nextPairPointer++;
        englishItems.push(makeItem(pair, "en"));
        portugueseItems.push(makeItem(pair, "pt"));
      }
    }

    function randomizeBoardPositions(){
      shuffle(englishItems);
      shufflePortugueseAvoidRows();
    }

    function speakEnglish(text){
      if(!("speechSynthesis" in window)) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = "en-US";
      utterance.rate = 0.82;
      utterance.pitch = 1;
      utterance.volume = 1;
      window.speechSynthesis.speak(utterance);
    }

    function makeAudioContext(){
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      if(!sharedAudioCtx){
        sharedAudioCtx = new AudioCtx();
      }
      if(sharedAudioCtx.state === "suspended"){
        sharedAudioCtx.resume();
      }
      return sharedAudioCtx;
    }

    function playSuccessChime(){
      try{
        const ctx = makeAudioContext();
        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.0001, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.20, ctx.currentTime + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.42);
        gain.connect(ctx.destination);

        [523.25, 659.25, 783.99].forEach((freq, i) => {
          const osc = ctx.createOscillator();
          osc.type = "sine";
          osc.frequency.setValueAtTime(freq, ctx.currentTime + i * 0.08);
          osc.connect(gain);
          osc.start(ctx.currentTime + i * 0.08);
          osc.stop(ctx.currentTime + 0.45);
        });
      }catch(e){}
    }

    function playVictoryMelody(){
      try{
        const ctx = makeAudioContext();
        const master = ctx.createGain();
        master.gain.setValueAtTime(0.0001, ctx.currentTime);
        master.gain.exponentialRampToValueAtTime(0.55, ctx.currentTime + 0.03);
        master.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 2.35);
        master.connect(ctx.destination);

        const notes = [523.25, 659.25, 783.99, 1046.5, 1318.5, 1046.5, 1568.0];
        notes.forEach((freq, i) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          const start = ctx.currentTime + i * 0.18;
          osc.type = i % 2 === 0 ? "triangle" : "sine";
          osc.frequency.setValueAtTime(freq, start);
          gain.gain.setValueAtTime(0.0001, start);
          gain.gain.exponentialRampToValueAtTime(0.75, start + 0.025);
          gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.32);
          osc.connect(gain);
          gain.connect(master);
          osc.start(start);
          osc.stop(start + 0.36);
        });
      }catch(e){}
    }

    function getMotivation(){
      const lines = [
        "Great job! Você encontrou o par correto.",
        "Excellent! Continue com foco.",
        "Nice match! Continue assim.",
        "Very good! Você está avançando.",
        "Amazing! Mais um par completo."
      ];
      return lines[Math.floor(Math.random() * lines.length)];
    }

    function winPhase(){
      locked = true;
      const next = currentPhase + 2;
      if(next > unlockedPhase){
        unlockedPhase = Math.min(next, TOTAL_PHASES);
      }

      playVictoryMelody();
      launchConfetti();

      resultIcon.textContent = currentPhase + 1 === TOTAL_PHASES ? "👑" : "🏆";
      resultTitle.textContent = currentPhase + 1 === TOTAL_PHASES ? "Você venceu o desafio!" : "Parabéns!";
      resultText.textContent = currentPhase + 1 === TOTAL_PHASES
        ? "Você concluiu todas as fases do QuantiCompare Challenge."
        : `Você completou a Fase ${currentPhase + 1} e liberou a próxima fase.`;

      mainResultBtn.textContent = currentPhase + 1 === TOTAL_PHASES ? "VOLTAR ÀS FASES" : "PRÓXIMA FASE";
      mainResultBtn.onclick = () => {
        closeOverlay();
        if(currentPhase + 1 < TOTAL_PHASES){
          startPhase(currentPhase + 1);
        } else {
          showPhases();
        }
      };

      overlay.classList.add("show");
    }

    function gameOver(){
      locked = true;
      resultIcon.textContent = "💔";
      resultTitle.textContent = "Game Over";
      resultText.textContent = "As vidas acabaram. Tente novamente e observe melhor as palavras.";
      mainResultBtn.textContent = "TENTAR DE NOVO";
      mainResultBtn.onclick = () => {
        closeOverlay();
        restartCurrentPhase();
      };
      overlay.classList.add("show");
    }

    function closeOverlay(){
      overlay.classList.remove("show");
    }

    function launchConfetti(){
      confettiBox.innerHTML = "";
      const colors = ["#00eaff", "#30ff9a", "#a855f7", "#ff3df2", "#ffd166"];

      for(let i = 0; i < 70; i++){
        const piece = document.createElement("div");
        piece.className = "piece";
        piece.style.left = Math.random() * 100 + "vw";
        piece.style.background = colors[Math.floor(Math.random() * colors.length)];
        piece.style.animationDuration = (1.6 + Math.random() * 1.6) + "s";
        piece.style.animationDelay = (Math.random() * .25) + "s";
        confettiBox.appendChild(piece);
      }

      setTimeout(() => confettiBox.innerHTML = "", 3400);
    }

    document.addEventListener("visibilitychange", () => {
      if(document.hidden && "speechSynthesis" in window){
        window.speechSynthesis.cancel();
      }
    });
  </script>
