          { en: "farther than the school", pt: "mais longe que a escola" },
          { en: "further than the bank", pt: "mais longe que o banco" },
          { en: "more modern than that one", pt: "mais moderno que aquele" },
          { en: "more famous than this singer", pt: "mais famoso que este cantor" }
        ]
      },
      {
        name: "Mix - Quantifiers and Comparatives",
        short: "mistura 1",
        tip: "Agora os dois conteúdos aparecem juntos. Leia com atenção.",
        pairs: [
          { en: "some students are taller than me", pt: "alguns alunos são mais altos que eu" },
